/* json.cls — Railroad diagram EBNF grammars */
/* Feed to the Railroad Diagram Generator at https://www.bottlecaps.de/rr/ui */

/* ======================================================================== */
/* JsonError class                                                          */
/* ======================================================================== */

JsonError_init
         ::= 'init(' message ( ',' lineNumber ( ',' column ( ',' contextLine )? )? )? ')'

JsonError_makeString
         ::= 'makeString'

JsonError_message
         ::= 'message'

JsonError_lineNumber
         ::= 'lineNumber'

JsonError_column
         ::= 'column'

JsonError_contextLine
         ::= 'contextLine'

/* ======================================================================== */
/* JsonBoolean class                                                        */
/* ======================================================================== */

JsonBoolean_true
         ::= 'true'

JsonBoolean_false
         ::= 'false'

JsonBoolean_activate
         ::= 'activate'

JsonBoolean_init
         ::= 'init(' value ')'

JsonBoolean_unknown
         ::= 'unknown(' messageName ',' arguments ')'

JsonBoolean_equal
         ::= '=(' other ')'

JsonBoolean_notEqual
         ::= ( '\=(' | '<>(' | '><(' ) other ')'

JsonBoolean_compareTo
         ::= 'compareTo(' other ')'

JsonBoolean_value
         ::= 'value'

JsonBoolean_makeString
         ::= 'makeString'

JsonBoolean_makeJSON
         ::= 'makeJSON'

/* ======================================================================== */
/* JsonString class                                                         */
/* ======================================================================== */

JsonString_makeJSON
         ::= 'makeJSON'

/* ======================================================================== */
/* Json class — class attributes                                            */
/* ======================================================================== */

Json_true
         ::= 'true'

Json_false
         ::= 'false'

/* ======================================================================== */
/* Json class — instance creation                                           */
/* ======================================================================== */

Json_init
         ::= 'init'

/* ======================================================================== */
/* Json class — file utilities (class methods)                              */
/* ======================================================================== */

Json_fromJsonFile
         ::= 'fromJsonFile(' fn ')'

Json_toJsonFile
         ::= 'toJsonFile(' fn ',' rexxObject ( ',' legible )? ')'

/* ======================================================================== */
/* Json class — encoding/decoding (instance and class methods)              */
/* ======================================================================== */

Json_toJSON
         ::= 'toJSON(' rexxObject ( ',' legible )? ')'

Json_fromJSON
         ::= 'fromJSON(' jsonString ')'

/* ======================================================================== */
/* Json class — XML support (class methods)                                */
/* ======================================================================== */

Json_jsonToXml
         ::= 'jsonToXml(' rexxObject ( ',' schema )? ')'

Json_jsonToXmlFile
         ::= 'jsonToXmlFile(' rexxObject ',' path ( ',' schema )? ')'

/* ======================================================================== */
/* Json class — XML support (instance methods)                             */
/* ======================================================================== */

Json_parseXml
         ::= 'parseXml(' input ')'

Json_parseXmlFile
         ::= 'parseXmlFile(' path ')'

/* ======================================================================== */
/* JsonXmlEmitter class                                                     */
/* ======================================================================== */

JsonXmlEmitter_init
         ::= 'init(' ( schema )? ')'

JsonXmlEmitter_emit
         ::= 'emit(' rexxObject ')'

/* ======================================================================== */
/* JsonXmlParser class                                                      */
/* ======================================================================== */

JsonXmlParser_parse
         ::= 'parse(' input ')'

/* ======================================================================== */
/* string2json routine                                                      */
/* ======================================================================== */

string2json
         ::= 'string2json(' buffer ',' rexxObject ( ',' forceQuoted )? ')'
