------------------------------------------------------------------------------------
-- Test the implementation of graphemeAtIndexG after adding support for end storage
------------------------------------------------------------------------------------

-- 0 grapheme, no storage limit, no end storage
.RexxUnicodeStringIndexer~new("")~graphemeIndexes=                  -- an Array (no shape, 0 items)
.RexxUnicodeStringIndexer~new("")~endGraphemeIndexes=               -- (The NIL object)
.RexxUnicodeStringIndexer~new("")~graphemeAtIndexG(-2)=             -- Invalid grapheme index: -2 exceeds the grapheme count 0.
.RexxUnicodeStringIndexer~new("")~graphemeAtIndexG(-1)=             -- Invalid grapheme index: -1 exceeds the grapheme count 0.
.RexxUnicodeStringIndexer~new("")~graphemeAtIndexG(0)=              -- Invalid grapheme index: 0.
.RexxUnicodeStringIndexer~new("")~graphemeAtIndexG(1)=              -- Invalid grapheme index: 1 exceeds the grapheme count 0.
.RexxUnicodeStringIndexer~new("")~graphemeAtIndexG(2)=              -- Invalid grapheme index: 2 exceeds the grapheme count 0.

-- 1 grapheme, no storage limit, no end storage
.RexxUnicodeStringIndexer~new("a")~graphemeAtIndexG(-2)=            -- Invalid grapheme index: -2 exceeds the grapheme count 1.
.RexxUnicodeStringIndexer~new("a")~graphemeAtIndexG(-1)=            -- 'a'
.RexxUnicodeStringIndexer~new("a")~graphemeAtIndexG(0)=             -- Invalid grapheme index: 0.
.RexxUnicodeStringIndexer~new("a")~graphemeAtIndexG(1)=             -- 'a'
.RexxUnicodeStringIndexer~new("a")~graphemeAtIndexG(2)=             -- Invalid grapheme index: 2 exceeds the grapheme count 1.

-- 5 graphemes, no storage limit, no end storage
