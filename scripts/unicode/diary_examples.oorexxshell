/*
.RexxUnicodeCodepointSupplier:

    Add .RexxUnicodeCodepointSupplier~codepointAtIndexC(indexC)

.RexxUnicodeGraphemeSupplier:

    Add .RexxUnicodeGraphemeSupplier~graphemeAtIndexG(indexG)


Examples
*/

string = "F4 91 92 93 FF 41 80 BF 42"x || "Joyeux Noël 👨‍👩‍👧"
codepointSupplier = .RexxUnicodeCodepointSupplier~new(string)
codepointSupplier~codepointAtIndexC(1)=     -- 65533
codepointSupplier~codepointAtIndexC(6)=     -- 65
codepointSupplier~codepointAtIndexC(6)=     -- 65
codepointSupplier~codepointAtIndexC(7)=     -- 65533
codepointSupplier~codepointAtIndexC(26)=    -- 128103
codepointSupplier~codepointAtIndexC(25)=    -- Invalid code point index: 25 is less than the current index 26 (the supplier can only advance).
codepointSupplier~codepointAtIndexC(26)=    -- 128103
codepointSupplier~codepointAtIndexC(27)=    -- No more supplier items available.
codepointSupplier~codepointAtIndexC(26)=    -- Invalid code point index: 26 is less than the current index 27 (the supplier can only advance).
codepointSupplier~codepointAtIndexC(0)=     -- Invalid code point index: 0.
codepointSupplier~codepointAtIndexC(-1)=    -- Invalid code point index: -1; negative indexes are not supported.

string = "F4 91 92 93 FF 41 80 BF 42"x || "Joyeux Noël 👨‍👩‍👧"
graphemeSupplier = .RexxUnicodeGraphemeSupplier~new(string)
graphemeSupplier~graphemeAtIndexG(1)~c2x=   -- 'F4'
graphemeSupplier~graphemeAtIndexG(6)=       -- 'A'
graphemeSupplier~graphemeAtIndexG(6)=       -- 'A'
graphemeSupplier~graphemeAtIndexG(7)~c2x=   -- '80'
graphemeSupplier~graphemeAtIndexG(22)=      -- '👨‍👩‍👧'
graphemeSupplier~graphemeAtIndexG(21)=      -- Invalid grapheme index: 21 is less than the current index 22 (the supplier can only advance).
graphemeSupplier~graphemeAtIndexG(22)=      -- '👨‍👩‍👧'
graphemeSupplier~graphemeAtIndexG(23)=      -- No more supplier items available.
graphemeSupplier~graphemeAtIndexG(22)=      -- Invalid grapheme index: 22 is less than the current index 23 (the supplier can only advance).
graphemeSupplier~graphemeAtIndexG(0)=       -- Invalid grapheme index: 0.
graphemeSupplier~graphemeAtIndexG(-1)=      -- Invalid grapheme index: -1; negative indexes are not supported.


