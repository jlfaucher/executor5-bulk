-- 2026 July 13

/*
[Unicode]

.RexxUnicodeStringIndexer:

    Update .RexxUnicodeStringIndexer~init
        Storage limits can be specified when creating the indexer; the default is no limit:
            - codepointStorageLimit
            - graphemeStorageLimit
            - errorStorageLimit

        End storage sizes can be specified when creating the indexer; the default is 0.
            - endCodepointStorageSize
            - endGraphemeStorageSize
            - endErrorStorageSize

        .RexxUnicodeStringIndexer~init(
            string,

            -- Storage limits
            codepointStorageLimit = (.RexxInfo~internalMaxNumber),
            graphemeStorageLimit = (.RexxInfo~internalMaxNumber),
            errorStorageLimit = (.RexxInfo~internalMaxNumber)

            -- End storage sizes
            endCodepointStorageSize = 0,
            endGraphemeStorageSize = 0,
            endErrorStorageSize = 0
            )

    Add ::attribute codepointStorageLimit get
    Add ::attribute graphemeStorageLimit get
    Add ::attribute errorStorageLimit get

    Add ::attribute codepointCount get    -- count after full scan, not impacted by codepointStorageLimit
    Add ::attribute graphemeCount get     -- count after full scan, not impacted by graphemeStorageLimit
    Add ::attribute errorCount get        -- count after full scan, not impacted by errorStorageLimit

    Add ::attribute endCodepointStorageSize get
    Add ::attribute endGraphemeStorageSize get
    Add ::attribute endErrorStorageSize get

    Add ::attribute endCodepointIndexes get
    Add ::attribute endGraphemeIndexes get
    Add ::attribute endErrors get


Examples
*/

-- Specify limits when creating the indexer
-- U+FFFD Substitution of Maximal Subparts
-- https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-3/#G68064
indexer = .RexxUnicodeStringIndexer~new("F4 91 92 93 FF 41 80 BF 42"x, 4, 2, 1)
-- The specified codepoint storage limit is 4
indexer~codepointCount=             -- 9
indexer~codepointStorageLimit=      -- 4
indexer~codepointIndexes=           -- [-1,-2,-3,-4]
indexer~codepointAtIndexC(3)=       -- 65533
indexer~codepointAtIndexC(5)=       -- Code point index 5 is not stored.
-- The specified grapheme storage limit is 2
indexer~graphemeCount=              -- 9
indexer~graphemeStorageLimit=       -- 2
indexer~graphemeIndexes=            -- [-1,-2]
indexer~graphemeAtIndexG(2)~c2x=    -- 91 (use ~c2x to not display an invalid byte sequence)
indexer~graphemeAtIndexG(3)~c2x=    -- Grapheme index 3 is not stored.
-- The specified error storage limit is 1
indexer~errorCount=                 -- 7
indexer~errorStorageLimit=          -- 1
indexer~errors==
/*
    an Array (shape [1], 1 items)
     1 : 'start byte position 1 : Invalid continuation byte 145 (''91''x) at byte position 2 (code point > U+10FFFF)'
*/

-- Collect counters, no need to store indexes and errors
string = "F4 91 92 93 FF 41 80 BF 42"x || "Joyeux Noël 👨‍👩‍👧"
indexer = .RexxUnicodeStringIndexer~new(string, 0, 0, 0)
indexer~graphemeCount=      -- 22
indexer~codepointCount=     -- 26
indexer~errorCount=         -- 7

-- Gets the five last grapheme indexes.
-- In case of error, reports only the first error.
string = "F4 91 92 93 FF 41 80 BF 42"x || "Joyeux Noël 👨‍👩‍👧"
indexer = .RexxUnicodeStringIndexer~new(string, /*codepointStorageLimit:*/ 0, /*graphemeStorageLimit:*/ 0, /*errorStorageLimit:*/ 1, /*endCodepointStorageSize:*/ 0, /*endGraphemeStorageSize:*/ 5)
indexer~errorCount=                 -- 7
indexer~errors~items=               -- 1
indexer~errors[1]=                  -- 'start byte position 1 : Invalid continuation byte 145 (''91''x) at byte position 2 (code point > U+10FFFF)'
indexer~endCodepointStorageSize=    -- 0
indexer~endCodepointIndexes=        -- (The NIL object)
indexer~endGraphemeStorageSize=     -- 5
indexer~endGraphemeIndexes=         -- [ 23, 22, 21, 19, 18]
indexer~endErrorStorageSize=        -- 0
indexer~endErrors=                  -- (The NIL object)
-- Tedious: Convert endIndexG to indexG
do endIndexG=1 to indexer~endGraphemeIndexes~items; indexG = indexer~graphemeCount - endIndexG + 1; say endIndexG "->" indexG":" indexer~graphemeAtIndexG(indexG); end
/*
    1 -> 22: 👨‍👩‍👧
    2 -> 21:
    3 -> 20: l
    4 -> 19: ë
    5 -> 18: o
*/
-- Easy: pass -endIndexG, where a negative index means "index from the end"
do endIndexG=1 to indexer~endGraphemeIndexes~items; say endIndexG":" indexer~graphemeAtIndexG(-endIndexG); end
/*
    1: 👨‍👩‍👧
    2:
    3: l
    4: ë
    5: o
*/


------------------------------------------------------------------------------------
-- Test the implementation of codepointAtIndexC after adding support for end storage
------------------------------------------------------------------------------------

-- 0 codepoint, no storage limit, no end storage
.RexxUnicodeStringIndexer~new("")~codepointIndexes=                 -- an Array (no shape, 0 items)
.RexxUnicodeStringIndexer~new("")~endCodepointIndexes=              -- (The NIL object)
.RexxUnicodeStringIndexer~new("")~codepointAtIndexC(-2)=            -- Invalid code point index: -2 exceeds the code point count 0.
.RexxUnicodeStringIndexer~new("")~codepointAtIndexC(-1)=            -- Invalid code point index: -1 exceeds the code point count 0.
.RexxUnicodeStringIndexer~new("")~codepointAtIndexC(0)=             -- Invalid code point index: 0.
.RexxUnicodeStringIndexer~new("")~codepointAtIndexC(1)=             -- Invalid code point index: 1 exceeds the code point count 0.
.RexxUnicodeStringIndexer~new("")~codepointAtIndexC(2)=             -- Invalid code point index: 2 exceeds the code point count 0.

-- 1 codepoint, no storage limit, no end storage
.RexxUnicodeStringIndexer~new("a")~codepointAtIndexC(-2)=           -- Invalid code point index: -2 exceeds the code point count 1.
.RexxUnicodeStringIndexer~new("a")~codepointAtIndexC(-1)=           -- 97
.RexxUnicodeStringIndexer~new("a")~codepointAtIndexC(0)=            -- Invalid code point index: 0.
.RexxUnicodeStringIndexer~new("a")~codepointAtIndexC(1)=            -- 97
.RexxUnicodeStringIndexer~new("a")~codepointAtIndexC(2)=            -- Invalid code point index: 2 exceeds the code point count 1.

-- 5 codepoints, no storage limit, no end storage
.RexxUnicodeStringIndexer~new("abcde")~codepointIndexes=            -- [ 1, 2, 3, 4, 5]
.RexxUnicodeStringIndexer~new("abcde")~endCodepointIndexes=         -- (The NIL object)
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(-6)=       -- Invalid code point index: -6 exceeds the code point count 5.
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(-5)=       -- 97
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(-4)=       -- 98
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(-3)=       -- 99
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(-2)=       -- 100
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(-1)=       -- 101
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(0)=        -- Invalid code point index: 0.
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(1)=        -- 97
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(2)=        -- 98
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(3)=        -- 99
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(4)=        -- 100
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(5)=        -- 101
.RexxUnicodeStringIndexer~new("abcde")~codepointAtIndexC(6)=        -- Invalid code point index: 6 exceeds the code point count 5.

-- 5 codepoints, storage limit 2, no end storage
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointIndexes=         -- [ 1, 2]
.RexxUnicodeStringIndexer~new("abcde", 2)~endCodepointIndexes=      -- (The NIL object)
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(-6)=    -- Invalid code point index: -6 exceeds the code point count 5.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(-5)=    -- 97
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(-4)=    -- 98
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(-3)=    -- Code point index -3 is not stored.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(-2)=    -- Code point index -2 is not stored.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(-1)=    -- Code point index -1 is not stored.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(0)=     -- Invalid code point index: 0.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(1)=     -- 97
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(2)=     -- 98
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(3)=     -- Code point index 3 is not stored.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(4)=     -- Code point index 4 is not stored.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(5)=     -- Code point index 5 is not stored.
.RexxUnicodeStringIndexer~new("abcde", 2)~codepointAtIndexC(6)=     -- Invalid code point index: 6 exceeds the code point count 5.

-- 5 codepoints, storage limit 2, end storage size 1
.RexxUnicodeStringIndexer~new("abcde", 2, , , 1)~codepointIndexes=              -- [ 1, 2]
.RexxUnicodeStringIndexer~new("abcde", 2, , , 1)~endCodepointIndexes=           -- [ 5]
.RexxUnicodeStringIndexer~new("abcde", 2, , , 1)~codepointAtIndexC(-6)=         -- Invalid code point index: -6 exceeds the code point count 5.
