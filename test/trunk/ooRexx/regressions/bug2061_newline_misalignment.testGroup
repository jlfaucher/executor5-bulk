  parse source . . s
  group = .TestGroup~new(s)
  group~add(.bug2061_newline_misalignment.testGroup)
  group~restrictOS("WINDOWS")

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult
-- End of entry point.

/* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*\
  Directives, Classes, or Routines.
\* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*/
::requires 'ooTest.frm'


/* class: bug2061_newline_misalignment.testGroup - - - - - - - - - - - - - - -*\

\* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*/
::class "bug2061_newline_misalignment.testGroup" public subclass ooTestCase

/*
The display of the cursor position is supported on Windows only.
When stdout is redirected, the cursor position is not available ("").
The misalignment is only a matter of display.
When capturing stdout, there is no leading spaces.

Console output on Windows before fix:
line 1 6
        line 2 14
                 line 3 23

Console output on Windows after fix:
line 1 6
line 2 6
line 3 6
*/

::method test_stdout_newline
    LF = "0A"x
    columns = .array~new
    do i = 1 to 3
        call charout .STDOUT, "line" i
        column = syscurpos()~word(2)
        columns~append(column)
        call charout .STDOUT, " "column
        call charout .STDOUT, LF
    end
    .STDOUT~say
    self~assertEquals((6, 6, 6), columns, "The STDOUT cursor column should be always 6")

::method test_stderr_newline
    LF = "0A"x
    columns = .array~new
    do i = 1 to 3
        call charout .STDERR, "line" i
        column = syscurpos()~word(2)
        columns~append(column)
        call charout .STDERR, " "column
        call charout .STDERR, LF
    end
    .STDERR~say
    self~assertEquals((6, 6, 6), columns, "The STDERR cursor column should be always 6")


-- End of class: bug2061_newline_misalignment.testGroup
