parse source . . s

group = .TestGroup~new(s)
group~add(.getBufferSize.testGroup)
if group~isAutomatedTest then
  return group
else
  return group~suite~execute~~print

::requires 'ooTest.frm'

::class "getbuffersize.testGroup" subclass ooTestCase public

::METHOD "testGetBufferSize"
   b = .mutableBuffer~new("")
   self~assertEquals(256, b~getBufferSize, "Buffer size incorrect 1")
   b = .mutableBuffer~new("",1)
   self~assertEquals(1, b~getBufferSize, "Buffer size incorrect 2")
   b~append("  ")
   self~assertEquals(2, b~getBufferSize, "Buffer size incorrect 3")

::method test_getBufferSize_too_many_args
  m = .MutableBuffer~new
  self~expectSyntax(93.902) -- Too many arguments in invocation
  m~getBufferSize(0)

::method test_bracketsEqual
  m = .MutableBuffer~new("1234", 5)
  self~assertEquals(5, m~getBufferSize)
  m[5] = "5"
  self~assertEquals("12345", m~string)
  self~assertEquals(5, m~getBufferSize)

::method test_replaceAt
  m = .MutableBuffer~new("1234", 5)
  self~assertEquals(5, m~getBufferSize)
  m~replaceAt("5", 5)
  self~assertEquals("12345", m~string)
  self~assertEquals(5, m~getBufferSize)

::method test_overlay
  m = .MutableBuffer~new("1234", 5)
  self~assertEquals(5, m~getBufferSize)
  m~overlay("5", 5)
  self~assertEquals("12345", m~string)
  self~assertEquals(5, m~getBufferSize)

::method test_changeStr
  m = .MutableBuffer~new("1234", 5)
  self~assertEquals(5, m~getBufferSize)
  m~changeStr("4", "45")
  self~assertEquals("12345", m~string)
  self~assertEquals(5, m~getBufferSize)

::method test_caselessChangeStr
  m = .MutableBuffer~new("123a", 5)
  self~assertEquals(5, m~getBufferSize)
  m~caselessChangeStr("A", "45")
  self~assertEquals("12345", m~string)
  self~assertEquals(5, m~getBufferSize)


::options all syntax
