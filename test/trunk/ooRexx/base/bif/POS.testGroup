  parse source . . s
  group = .TestGroup~new(s)
  group~add(.POS.testGroup)

  if group~isAutomatedTest then return group

  testResult = group~suite~execute~~print

return testResult

::requires 'ooTest.frm' -- load the ooRexxUnit classes

-- class named exactly like file
::class "POS.testGroup" subclass ooTestCase public

::method 'test001'
    self~assertSame('0', pos('',''))

::method 'test002'
    self~assertSame('0', pos('','a'))

::method 'test003'
    self~assertSame('0', pos('','123233'x))

::method 'test004'
    a = 'abcd'
    self~assertSame('0', pos('',a))

::method 'test006'
    a. = 'efgh'
    i = 3
    self~assertSame('0', pos('',a.i))

::method 'test012'
    self~assertSame('0', pos('','abcde' 'fghij'))

::method 'test013'
    self~assertSame('0', pos('','111'||'222'))

::method 'test014'
    self~assertSame('0', pos('',111+12))

::method 'test015'
    self~assertSame('0', pos('a',''))

::method 'test016'
    self~assertSame('1', pos('a','a'))

::method 'test017'
    self~assertSame('2', pos('2','123233'x))

::method 'test018'
    a = 'abcd'
    self~assertSame('1', pos('a',a))

::method 'test020'
    a.3 = '333333'
    i = 3
    self~assertSame('1', pos('3',a.i))

::method 'test026'
    self~assertSame('5', pos('e','abcde' 'fghij'))

::method 'test027'
    self~assertSame('4', pos('2','111'||'222'))

::method 'test028'
    self~assertSame('2', pos('2',111+12))

::method 'test029'
    self~assertSame('0', pos('1',''))

::method 'test030'
    self~assertSame('0', pos('1','a'))

::method 'test031'
    self~assertSame('0', pos('1','123233'x))

::method 'test032'
    a = 'abcd'
    self~assertSame('0', pos('z',a))

::method 'test034'
    a.3 = '333333'
    i = 3
    self~assertSame('0', pos('z',a.i))

::method 'test039'
    self~assertSame('0', pos('z','abcde' 'fghij'))

::method 'test040'
    self~assertSame('0', pos('z','111'||'222'))

::method 'test041'
    self~assertSame('0', pos('z',111+12))

::method 'test042'
    .local~h = reverse('abcdefghijklmnopqrstuvwxyz')
    .local~h = copies(.h,1000)||'*'||copies(.h,100)||'.'

::method 'test043'
    self~assertSame('0', pos('ef',.h))

::method 'test044'
    self~assertSame('0', pos('z*',.h))

::method 'test045'
    self~assertSame('0', pos('z.',.h))

::method 'test046'
    self~assertSame('28602', pos('.',.h))

::method 'test047'
    self~assertSame('0', pos('. ',.h))

::method 'test048'
    numeric digits 2
    self~assertSame('28602', pos('.',.h))

::method 'test049'
    self~assertSame('0', pos('ef',.h,1))

::method 'test050'
    self~assertSame('0', pos('z*',.h,1))

::method 'test051'
    self~assertSame('0', pos('z.',.h,1))

::method 'test052'
    self~assertSame('28602', pos('.',.h,1))

::method 'test053'
    self~assertSame('0', pos('. ',.h,1))

::method 'test054'
    numeric digits 2
    self~assertSame('28602', pos('.',.h,1))

::method 'test055'
    self~assertSame('0', pos('ef',.h,1000))

::method 'test056'
    self~assertSame('0', pos('z*',.h,1000))

::method 'test057'
    self~assertSame('0', pos('z.',.h,1000))

::method 'test058'
    self~assertSame('28602', pos('.',.h,1000))

::method 'test059'
    self~assertSame('0', pos('. ',.h,1000))

::method 'test060'
    numeric digits 2
    self~assertSame('28602', pos('.',.h,1000))

::method 'test061'
    self~assertSame('0', pos('ef',.h,1.e5))

::method 'test062'
    self~assertSame('0', pos('z*',.h,1.e5))

::method 'test063'
    self~assertSame('0', pos('z.',.h,1.e5))

::method 'test064'
    self~assertSame('0', pos('.',.h,1.e5))

::method 'test065'
    self~assertSame('0', pos('. ',.h,1.e5))

::method 'test066'
    numeric digits 2
    self~assertSame('0', pos('.',.h,1.e5))

::method 'test067'
    s0 = ''
    s1 = 'a'
    s30 = copies('6',30)||'...'
    s255 = copies('*',255)||'1234e+3'
    s32768 = copies('ab',16383)||'abcde'
    s500000 = copies('.',500000)||'zzzzzzz'

    self~assertSame(1, pos('a', s1))
    self~assertSame(30, pos('6.', s30))
    self~assertSame(255, pos('*1', s255))
    self~assertSame(32767, pos('abc', s32768))
    self~assertSame(32768, pos('bc', s32768))
    self~assertSame(32769, pos('cde', s32768))
    self~assertSame(500001, pos('zzzz', s500000))

::method 'test077'
    self~expectSyntax(40.12)
    call pos '34', '123456789', ''

