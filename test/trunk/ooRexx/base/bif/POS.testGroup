    self~assertSame('0', pos('-','--------',0.0000001e12))

::method 'test096'
    self~expectSyntax(40.12)
    xre = pos('-','--------',.abc)

::method 'test097'
    self~expectSyntax(40.12)
    xre = pos('-','--------','a')

::method 'test098'
    a = xrange('a','z')
    b = xrange('i','s')
    c = 6
    self~assertSame('9', pos(b,a,c))

-- from bif.testgroup
   -- test the BIF, using examples from the documentation
::method "test_POS"
    self~assertEquals(6, POS('day','Saturday'))
    self~assertEquals(0, POS('x','abc def ghi'))
    self~assertEquals(4, POS(' ','abc def ghi'))
    self~assertEquals(8, POS(' ','abc def ghi',5))

   -- new test
    self~assertEquals(0, POS('','abc def ghi',5))

::method testRange01
    self~assertSame('0', pos('','',,100))
    self~assertSame('0', pos('','',,0))
    self~assertSame('0', pos('e','abcdeeeeef',,4))
    self~assertSame('0', pos('e','abcdeeeeef',1,4))
    self~assertSame('5', pos('e','abcdeeeeef',2,4))
    self~assertSame('0', pos('eee','abcdeeeeef',5,2))

::method testRange02
    self~expectSyntax(40.12)
    xre = pos('34','123456789',1,'xxx')

::method testRange03
    self~expectSyntax(93.923)
    xre = pos('-','--------',1,-12)

::method testRange04
    self~expectSyntax(40.12)
    xre = pos('-','--------',1,0.5)


-- [bugs:#2083] POS arg four does not bound the search
::method test_bug2083_length
  self~assertEquals(0, pos("an", "axan", 1, 3))
  self~assertEquals(0, pos("an", "zxan", 1, 3))
  self~assertEquals(3, pos("an", "axan", 1, 4))

  self~assertEquals(0, pos("abc", "axxabc", 1, 5))
  self~assertEquals(0, pos("abc", "zxxabc", 1, 5))
  self~assertEquals(4, pos("abc", "axxabc", 1, 6))

  self~assertEquals(0, pos("an", "axaxan", 1, 4))
  self~assertEquals(0, pos("an", "axaxan", 1, 5))
  self~assertEquals(5, pos("an", "axaxan", 1, 6))

::method test_bug2083_terminator
  needle = "a" || '00'x
  self~assertEquals(0, pos(needle, "aa"))
  self~assertEquals(0, countstr(needle, "aa"))
  self~assertEquals("aa", changestr(needle, "aa", "ZZZ"))

::method test_bug2083_nul
  needle = "a" ||  '00'x
  haystack = "aa" ||  '00'x
  self~assertEquals(2, pos(needle, haystack))
  self~assertEquals(1, countstr(needle, haystack))
  self~assertEquals("aZZZ", changestr(needle, haystack, "ZZZ"))


::options all syntax
