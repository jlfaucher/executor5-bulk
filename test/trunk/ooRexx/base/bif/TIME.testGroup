parse source . . fileSpec
group = .TestGroup~new(fileSpec)
group~add(.TIME.fast.testGroup)
--group~add(.TIME.long.testGroup)
if group~isAutomatedTest then
  return group
else
  return group~suite~execute~~print

::requires 'ooTest.frm'

::class TIME.fast.testGroup subclass ooTestCase public

::constant optionsArg1 "CEFHLMNORST"
::constant optionsArg3 "CFHLMNOST"    -- all, except E, and R
::constant maxTicks 253402300799      -- .DateTime~maxDate~ticks
::constant minTicks -62135596800      -- .DateTime~minDate~ticks
::constant maxFull 315537897599999999 -- .DateTime~maxDate~fullDate
::constant minFull 0                  -- .DateTime~minDate~fullDate
::constant epoch 62135596800          -- seconds between 0001-01-01 and 1970-01-01


::method test_arg_one_invalid
  self~expectSyntax((40.904, "TIME", 1, self~optionsArg1, "-")) -- TIME argument 1 must be one of CEFHLMNORST; found "-"
  call time "-"

::method test_arg_two_noformat
  self~expectSyntax(40.19) -- TIME argument 2, "", is not in the format described by argument 3, "N"
  call time , ""

::method test_args_three_onetwo_missing
  self~expectSyntax(40.5) -- Missing argument in invocation of TIME; argument 2 is required
  call time , , "n"

::method test_args_three_two_missing
  self~expectSyntax(40.5) -- Missing argument in invocation of TIME; argument 2 is required
  call time , , "n"

::method test_arg_three_invalid
  self~expectSyntax((40.904, "TIME", 3, self~optionsArg3, "W")) -- TIME argument 3 must be one of CFHLMNOST; found "W"
  call time , 0, "w" -- w is invalid for arg 3

::method test_arg_three_noformat
  self~expectSyntax(40.19) -- TIME argument 2, "", is not in the format described by argument 3, "F"
  call time , "", "f"

::method test_args_four_too_many
  self~expectSyntax((40.4, "TIME", 3)) -- Too many arguments in invocation of TIME; maximum expected is 3
  call time , , , ""


-- two time stamps within the same clause must always be equal
::method test_single_clause
  do opt over self~optionsArg1~makeArray("")
    self~assertSame(time(opt), time(opt), time(opt) "time stamp must match" time(opt))
  end

::method test_same_options
  -- TIME(x) should be the same as TIME(x, TIME(x), x)
  do option over self~optionsArg3~makeArray("")
    self~assertSame(time(option), time(option, time(option), option), "TIME("option") should be TIME("option", TIME("option")," option")")
  end


-- all options, simple form

-- omitted means the same as "normal" (hh:mm:ss)
::method test_simple_normal
  self~assertSame(time(), time("normal"))
  parse value time() with hh ":" mm ":" ss
  -- hours can have the values 00 through 23
  self~assertTrue(hh~length = 2, "hours should be two digits, found" hh)
  self~assertTrue(hh~verify(.String~digit) = 0, "hours should be two digits, found" hh)
  self~assertTrue(hh >= 0, "hours should be >= 0, found" hh)
  self~assertTrue(hh <= 23, "hours should be <= 23, found" hh)
  -- minutes and seconds, 00 through 59
  self~assertTrue(mm~length = 2, "minutes should be two digits, found" mm)
  self~assertTrue(mm~verify(.String~digit) = 0, "minutes should be two digits, found" mm)
  self~assertTrue(mm >= 0, "minutes should be >= 0, found" mm)
  self~assertTrue(mm <= 59, "minutes should be <= 59, found" mm)
  self~assertTrue(ss~length = 2, "seconds should be two digits, found" ss)
  self~assertTrue(ss~verify(.String~digit) = 0, "seconds should be two digits, found" ss)
  self~assertTrue(ss >= 0, "seconds should be >= 0, found" ss)
  self~assertTrue(ss <= 59, "seconds should be <= 59, found" ss)

-- long, hh:mm:ss.uuuuuu
::method test_simple_long
  parse value time("long") time() with timeL time
  parse var timeL hhL ":" mmL ":" ssL "." uuuuuu
  parse var time hh ":" mm ":" ss
  -- hours, minutes, seconds must match
  self~assertSame(hhL, hh)
  self~assertSame(mmL, mm)
  self~assertSame(ssL, ss)
  self~assertTrue(uuuuuu~length = 6, "uuuuuu should be six digits, found" uuuuuu)
  self~assertTrue(uuuuuu~verify(.String~digit) = 0, "uuuuuu should be digits, found" uuuuuu)

-- civil, hh:mmam, hh:mmpm
::method test_simple_civil
  parse value time("civil") time() with timeC time
  parse var timeC hhC ":" mmC
  parse var mmC mmC +2 meridiem
  parse var time hh ":" mm ":" ss
  -- hours can take the values 1 through 12
  self~assertTrue(hhC~length = 1 | hhC~length = 2, "hours should be one or two digits, found" hhC)
  self~assertTrue(hhC~verify(.String~digit) = 0, "hours should be digits, found" hhC)
  self~assertTrue(hhC >= 0, "hours should be >= 0, found" hhC)
  self~assertTrue(hhC <= 12, "hours should be <= 12, found" hhC)
  select
    when hh = 0 then self~assertSame(hhC, "12")
    when hh <= 12 then self~assertSame(hhC, hh + 0)
    otherwise self~assertSame(hhC, hh - 12)
  end
  -- minutes must match, am, pm
  self~assertSame(mmC, mm)
  self~assertSame(meridiem, (hh < 12)~?("am", "pm"))

-- hours, hh, no leading zeroes
::method test_simple_hours
  parse value time("hours") time() with h time
  parse var time hh ":" mm ":" ss
  self~assertSame(h, hh + 0)
  self~assertFalse(h~startsWith("0"), "h should have no leading zeroes, found" h)

-- minutes, mmmm, no leading zeroes
::method test_simple_minutes
  parse value time("minutes") time() with mmmm time
  parse var time hh ":" mm ":" ss
  self~assertTrue(mmmm~length >= 1 & mmmm~length <= 4, "mmmm should be one to four digits, found" mmmm)
  self~assertTrue(mmmm~verify(.String~digit) = 0, "mmmm should be digits, found" mmmm)
  self~assertSame(mmmm, hh * 60 + mm)
  self~assertFalse(mmmm~startsWith("0"), "mmmm should have no leading zeroes, found" mmmm)

-- seconds, sssss, no leading zeroes
::method test_simple_seconds
  parse value time("seconds") time() with sssss time
  parse var time hh ":" mm ":" ss
  self~assertTrue(sssss~length >= 1 & sssss~length <= 5, "seconds should be one to five digits, found" sssss)
  self~assertTrue(sssss~verify(.String~digit) = 0, "sssss should be digits, found" sssss)
  self~assertSame(sssss, hh * 3600 + mm * 60 + ss)
  self~assertFalse(sssss~startsWith("0"), "sssss should have no leading zeroes, found" sssss)

-- ticks, dddddddddddd seconds since 1.1.1970, no leading zeroes
::method test_simple_ticks
  parse value time("ticks") time() time("seconds") date("ticks") date("base") with ticks time seconds dateTicks dateBase
  parse var time hh ":" mm ":" ss
  -- may have a leading minus
  self~assertTrue(ticks~length >= 1 & ticks~length <= 13, "ticks should be one to 13 digits/minus, found" ticks)
  self~assertTrue(ticks~verify(.String~digit || "-") = 0, "ticks should be digits, found" ticks)
  self~assertFalse(ticks~startsWith("0"), "ticks should have no leading zeroes, found" ticks)
  self~assertSame(ticks, dateTicks)
  numeric digits 18
  self~assertSame(ticks, dateBase * 24 * 3600 + seconds - self~epoch)

-- full, dddddddddddddddddd microseconds since 1.1.0001, no leading zeroes
::method test_simple_full
  parse value time("full") time("long") time("seconds") date("full") date("base") with full long seconds dateFull dateBase
  parse var long hh ":" mm ":" s
  self~assertTrue(full~length >= 1 & full~length <= 18, "full should be one to 18 digits, found" full)
  self~assertTrue(full~verify(.String~digit) = 0, "full should be digits, found" full)
  self~assertFalse(full~startsWith("0"), "full should have no leading zeroes, found" full)
  self~assertSame(full, dateFull)
  numeric digits 18
  self~assertSame(full, (dateBase * 24 * 3600 + seconds) * 1000000 + s~right(6))

-- offset, microseconds
::method test_simple_offset
  offset = time("offset")
  numeric digits 18
  self~assertTrue(offset~dataType("W"), "offset should be a whole number, found" offset)
  -- timee zone offsets are expected be less than 24 hours
  self~assertTrue(offset~abs <= 24 * 3600 * 1000000, "offset expected to be less than 24 hours, found" offset)

-- elapsed
::method test_simple_elapsed
  -- on the first call, the elapsed-time clock is started and returns 0
  self~assertSame(time("elapsed"), 0)
  call SysSleep 0.01
  elapsed = time("elapsed")
  self~assertSame(1, elapsed~countStr("."))
  self~assertTrue(elapsed~verify(.String~digit || ".") = 0, "elapsed should be digits/dot, found" elapsed)
  self~assertSame("NUM", elapsed~dataType, "elapsed should be a number, found" elapsed)
  self~assertTrue(elapsed > 0, "elapsed should be > 0, found" elapsed)
  -- if the elapsed time exceeds nine digits an error results
  self~assertTrue(elapsed <= 999999999, "elapsed should be < 999999999, found" elapsed)

-- reset
::method test_simple_reset
  -- on the first call, the elapsed-time clock is started and returns 0
  self~assertSame(time("reset"), 0)
  call SysSleep 0.01
  elapsed = time("elapsed")
  self~assertSame(1, elapsed~countStr("."))
  self~assertTrue(elapsed~verify(.String~digit || ".") = 0, "elapsed should be digits/dot, found" elapsed)
  self~assertSame("NUM", elapsed~dataType, "elapsed should be a number, found" elapsed)
  self~assertTrue(elapsed > 0, "elapsed should be > 0, found" elapsed)
  -- if the elapsed time exceeds nine digits an error results
  self~assertTrue(elapsed <= 999999999, "elapsed should be <= 999999999, found" elapsed)


-- conversion forms (some legacy c, h, l, n, tests already exist further down)

-- long, conversion form

::method test_long_no_fractions
  self~expectSyntax(40.19) -- TIME argument 2, "00:00:00", is not in the format described by argument 3, "L"
  call time , "00:00.00", "long"

::method test_long_fraction_dot
  self~expectSyntax(40.19) -- TIME argument 2, "00:00:00.", is not in the format described by argument 3, "L"
  call time , "00:00.00.", "long"

::method test_long_fractions_too_many
  self~expectSyntax(40.19) -- TIME argument 2, "00:00:00.0000000", is not in the format described by argument 3, "L"
  call time , "00:00.00.0000000", "long"

::method test_long_hours_missing
  self~expectSyntax(40.19) -- TIME argument 2, "00:00.0000000", is not in the format described by argument 3, "L"
  call time , "00:00.00.000000", "long"

::method test_long_hours_range
  self~expectSyntax(40.19)
  call time , "24:00.00.000000", "long"

::method test_long_minutes_range
  self~expectSyntax(40.19)
  call time , "12:60.00.000000", "long"

::method test_long_seconds_range
  self~expectSyntax(40.19)
  call time , "01:02.60.000000", "long"

::method test_long
  -- for a full validation of the L conversion, we test both date and time
  f = time("full", "12:34:12.345678", "long")
  self~assertSame("0001-01-01 12:34:12.345678", date("iso", f, "full") time("long", f, "full"))

  self~assertSame("23:59:59.999999", time("long", "23:59:59.999999", "long"))
  self~assertSame("00:00:00.000000", time("long", "00:00:00.000000", "long"))
  self~assertSame("01:23:45.600000", time("long", "01:23:45.6", "long"))
  self~assertSame("01:23:45.670000", time("long", "01:23:45.67", "long"))
  self~assertSame("01:23:45.678000", time("long", "01:23:45.678", "long"))
  self~assertSame("01:23:45.678900", time("long", "01:23:45.6789", "long"))
  self~assertSame("01:23:45.678900", time("long", "01:23:45.67890", "long"))
  self~assertSame("01:23:45.678901", time("long", "01:23:45.678901", "long"))

-- civil, conversion form

::method test_civil_00am_invalid
  self~expectSyntax(40.19) -- TIME argument 2, "00:00am", is not in the format described by argument 3, "C"
  call time , "00:00am", "civil"

::method test_civil_00pm_invalid
  self~expectSyntax(40.19) -- TIME argument 2, "00:00pm", is not in the format described by argument 3, "C"
  call time , "00:00pm", "civil"

::method test_civil_13am_invalid
  self~expectSyntax(40.19) -- TIME argument 2, "13:00am", is not in the format described by argument 3, "C"
  call time , "13:00am", "civil"

::method test_civil_13pm_invalid
  self~expectSyntax(40.19) -- TIME argument 2, "13:00pm", is not in the format described by argument 3, "C"
  call time , "13:00pm", "civil"


-- ticks, conversion form

::method test_ticks_too_high
  numeric digits 18
  self~expectSyntax(40.19) -- TIME argument 2, "253402300800", is not in the format described by argument 3, "T"
  call time , self~maxTicks + 1, "ticks"

::method test_ticks_too_low
  numeric digits 18
  self~expectSyntax(40.19) -- TIME argument 2, "-62135596801", is not in the format described by argument 3, "T"
  call time , self~minTicks - 1, "ticks"

::method test_ticks_range
  -- for a full validation of the T conversion, we test both date and time
  self~assertSame("9999-12-31 23:59:59.000000", date("iso", self~maxTicks, "ticks") time("long", self~maxTicks, "ticks"))
  self~assertSame("0001-01-01 00:00:00.000000", date("iso", self~minTicks, "ticks") time("long", self~minTicks, "ticks"))

::method test_ticks_round_down_bug
  -- time (here: ticks) should never be rounded up, but C integer division ("/")
  -- rounds towards zero, which is down for positive, but up for negative
  -- dividends (when, as here, the divisor MICROSECONDS is positive)
  -- so, getUnixTime()'s ticks calculation is/was off by one for negative ticks:
  --   // subtract the baseline time and convert to seconds.
  --   return (getBaseTime() - unixBaseTime.getBaseTime()) / (int64_t)MICROSECONDS;
  -- (ticks are negative here because TIME() uses date 0001-01-01)
  self~assertSame( -
    time(, '17:26:12.291000', 'l') ,         time(, time('t', '17:26:12.291000', 'l'), 't'), -
   "time(, '17:26:12.291000', 'l') should be time(, time('t', '17:26:12.291000', 'l'), 't')")


-- full, conversion form

::method test_full_too_high
  numeric digits 18
  self~expectSyntax(40.19) -- TIME argument 2, "315537897600000000", is not in the format described by argument 3, "F"
  call time , self~maxFull + 1, "full"

::method _test_full_too_low
  numeric digits 18
  self~expectSyntax(40.19) -- TIME argument 2, "-1", is not in the format described by argument 3, "F"
  call time , self~minFull - 1, "full"

::method test_full_max
  self~assertSame("23:59:59.999999", time("long", self~maxFull, "full"))
  self~assertSame("00:00:00.000000", time("long", self~minFull, "full"))


-- hours, conversion form

::method test_hours_too_high
  self~expectSyntax(40.19) -- TIME argument 2, "24", is not in the format described by argument 3, "H"
  call time , 24, "hours"

::method _test_hours_too_low
  self~expectSyntax(40.19) -- TIME argument 2, "-1", is not in the format described by argument 3, "H"
  call time , -1, "hours"

::method test_hours_range
  -- for a full validation of the H conversion, we test both date and time
  t = time("ticks", 23, "hours")
  self~assertSame("0001-01-01 23:00:00.000000", date("iso", t, "ticks") time("long", t, "ticks"))
  t = time("ticks", 0, "hours")
  self~assertSame("0001-01-01 00:00:00.000000", date("iso", t, "ticks") time("long", t, "ticks"))


-- minutes, conversion form

::method test_minutes_too_high
  self~expectSyntax(40.19) -- TIME argument 2, "1440", is not in the format described by argument 3, "M"
  call time , 24 * 60, "minutes"

::method _test_minutes_too_low
  self~expectSyntax(40.19) -- TIME argument 2, "-1", is not in the format described by argument 3, "M"
  call time , -1, "minutes"

::method test_minutes_range
  -- for a full validation of the M conversion, we test both date and time
  t = time("ticks", 24 * 60 - 1, "minutes")
  self~assertSame("0001-01-01 23:59:00.000000", date("iso", t, "ticks") time("long", t, "ticks"))
  t = time("ticks", 0, "hours")
  self~assertSame("0001-01-01 00:00:00.000000", date("iso", t, "ticks") time("long", t, "ticks"))


-- seconds, conversion form

::method test_seconds_too_high
  self~expectSyntax(40.19) -- TIME argument 2, "86400", is not in the format described by argument 3, "S"
  call time , 24 * 3600, "seconds"

::method _test_seconds_too_low
  self~expectSyntax(40.19) -- TIME argument 2, "-1", is not in the format described by argument 3, "S"
  call time , -1, "seconds"

::method test_seconds_range
  -- for a full validation of the S conversion, we test both date and time
  t = time("ticks", 24 * 3600 - 1, "seconds")
  self~assertSame("0001-01-01 23:59:59.000000", date("iso", t, "ticks") time("long", t, "ticks"))
  t = time("ticks", 0, "seconds")
  self~assertSame("0001-01-01 00:00:00.000000", date("iso", t, "ticks") time("long", t, "ticks"))


-- offset, conversion form

::method test_from_offset_too_high
  self~expectSyntax(40.19) -- TIME argument 2, "315537897599999999", is not in the format described by argument 3, "O"
  call time , self~maxFull, "offset"

::method test_offset
  numeric digits 18
  oneHour = 3600 * 1000000
  self~assertSame( -
   time("full") - time("offset") + oneHour, -
   time("full", oneHour, "offset"))


-- elapsed, reset, (invalid) conversion form

::method test_from_elapsed_invalid
  self~expectSyntax(40.904) -- TIME argument 3 must be one of CFHLMNOST; found "E"
  call time , 0, "elapsed"

::method test_to_elapsed_invalid
  self~expectSyntax(40.29) -- TIME conversion to format "E" is not allowed
  call time "elapsed", 0, "full"

::method test_from_reset_invalid
  self~expectSyntax(40.904) -- TIME argument 3 must be one of CFHLMNOST; found "R"
  call time , 0, "reset"

::method test_to_reset_invalid
  self~expectSyntax(40.29) -- TIME conversion to format "R" is not allowed
  call time "reset", 0, "full"


-- legacy

::method "test_1"
   Numeric Digits 20                   /* PA 881104 added                */

   tx=TIME( )||'**'||TIME('l')||'*'||TIME('h')||'*'||TIME('m')||'*'||,
    TIME('s')||'*'||TIME('e')||'*'||TIME('r')||'*'||,
    TIME('c')||'*'||TIME('n')'**'||,
    TIME('L')||'*'||TIME('H')||'*'||TIME('M')||'*'||,
    TIME('S')||'*'||TIME('E')||'*'||TIME('R')||'*'||,
    TIME('C')||'*'||TIME('N')
   Parse Var tx tt '**' tx '**' ty
   Parse Var tt tth ':' ttm ':' tts
   Parse Var tx txl '*' txh '*' txm '*' txs '*' txe '*' txr '*' txc '*' txn
   Parse Var ty tyl '*' tyh '*' tym '*' tys '*' tye '*' tyr '*' tyc '*' tyn
   v.1='l'; v.2='h'; v.3='m'; v.4='s'; v.5='e'; v.6='r'; v.7='c'
   v.8='L'; v.9='H'; v.a='M'; v.b='s'; v.c='E'; v.d='R'; v.e='C'
   v.f='n'; v.g='N'
   vx=TIME( )||'**'||TIME(v.1)||'*'||TIME(v.2)||'*'||TIME(v.3)||'*'||,
    TIME(v.4)||'*'||TIME(v.5)||'*'||TIME(v.6)||'*'||,
    TIME(v.7)||'*'||TIME(v.f)'**'||,
    TIME(v.8)||'*'||TIME(v.9)||'*'||TIME(v.a)||'*'||,
    TIME(v.b)||'*'||TIME(v.c)||'*'||TIME(v.d)||'*'||,
    TIME(v.e)||'*'||TIME(v.g)
   Parse Var vx vt '**' vx '**' vy
   Parse Var vt vth ':' vtm ':' vts
   Parse Var vx vxl '*' vxh '*' vxm '*' vxs '*' vxe '*' vxr '*' vxc '*' vxn
   Parse Var vy vyl '*' vyh '*' vym '*' vys '*' vye '*' vyr '*' vyc '*' vyn

   self~assertSame(tt, txn)
   self~assertSame(txn, tyn)
   self~assertSame(vt, vxn)
   self~assertSame(vxn, vyn)

   self~assertSame(tx, ty)
   self~assertSame(txm, ttm+60*tth)
   self~assertSame(txs, tts+60*(ttm+60*tth))
   If tth<10 Then self~assertSame(txh, right(tth, 1))
   else self~assertSame(txh, tth)

   self~assertSame(vx, vy)
   self~assertSame(vxm, vtm+60*vth)
   self~assertSame(vxs, vts+60*(vtm+60*vth))
   If vth<10 Then self~assertSame(vxh, right(vth,1))
   else self~assertSame(vxh, vth)

   self~assertSame(txe, txr)
   self~assertSame(txe, '0')

   self~assertSame(vxe, vxr)

   self~assertSame(txl, tyl)
   self~assertSame(vxl, vyl)

   Parse Var txl txlh ':' txlm ':' txls '.' txlms
   Parse Var vxl vxlh ':' vxlm ':' vxls '.' vxlms
   tmsc=SUBSTR(txl,9,7)
   vmsc=SUBSTR(vxl,9,7)
   Numeric Digits 20
   txlc=txls+60*(txlm+60*txlh)+tmsc
   vxlc=vxls+60*(vxlm+60*vxlh)+vmsc
   xlc=vxlc-txlc

   self~assertSame(vxr, xlc)

   Parse Var txc txch ':' txcx
   txcm=SUBSTR(txcx,1,2)
   txct=SUBSTR(txcx,3,2)
   tth1=RIGHT(tth,1)
   Select
     When tth=0  Then self~assertSame(txch txct, 12 'am')
     When tth<10 Then self~assertSame(txch txct, tth1 'am')
     When tth<12 Then self~assertSame(txch txct, tth 'am')
     When tth=12 Then self~assertSame(txch txct, tth 'pm')
     When tth>12 Then self~assertSame(txch+12 txct, tth 'pm')
     Otherwise self~assertFalse(1)
   End
   self~assertSame(txcm, ttm)

   Parse Var txc txch ':' txcx
   txcm=SUBSTR(txcx,1,2)
   txct=SUBSTR(txcx,3,2)
   tth1=RIGHT(tth,1)
   Select
     When tth=0  Then self~assertSame((txch txct), '12 am')
     When tth<10 Then self~assertSame((txch txct), (tth1 'am'))
     When tth<12 Then self~assertSame((txch txct), (tth 'am'))
     When tth=12 Then self~assertSame((txch txct), (tth 'pm'))
     When tth>12 Then self~assertSame((txch+12 txct), (tth 'pm'))
     Otherwise self~assertFalse(1)
   End
   self~assertSame(txcm, ttm)


::method "test_7"
   Call time 'r'                       /* reset the timer for the next  */
   xxyy=1                              /* do very little work           */
   tx=TIME( )||'**'||TIME('life')||'*'||TIME('honour')||'*'||,
    TIME('micro')||'*'||TIME('short')||'*'||,
    TIME('europe')||'*'||TIME('rage')||'*'||,
    TIME('carbon')||'**'||,
    TIME('LIFE')||'*'||TIME('HONOUR')||'*'||,
    TIME('MICRO')||'*'||TIME('SHORT')||'*'||,
    TIME('EUROPE')||'*'||TIME('RAGE')||'*'||,
    TIME('CARBON')
   Parse Var tx tt '**' tx '**' ty
   Parse Var tt tth ':' ttm ':' tts
   Parse Var tx txl '*' txh '*' txm '*' txs '*' txe '*' txr '*' txc
   Parse Var ty tyl '*' tyh '*' tym '*' tys '*' tye '*' tyr '*' tyc
   v.1='life'; v.2='honour'; v.3='micro'; v.4='short'; v.5='europe';
   v.6='rage'; v.7='carbon'; v.8='LIFE'; v.9='HONOUR'; v.a='MICRO';
   v.b='SHORT'; v.c='EUROPE'; v.d='RAGE'; v.e='CARBON'
   vx=TIME( )||'**'||TIME(v.1)||'*'||TIME(v.2)||'*'||TIME(v.3)||'*'||,
    TIME(v.4)||'*'||TIME(v.5)||'*'||TIME(v.6)||'*'||,
    TIME(v.7)||'**'||,
    TIME(v.8)||'*'||TIME(v.9)||'*'||TIME(v.a)||'*'||,
    TIME(v.b)||'*'||TIME(v.c)||'*'||TIME(v.d)||'*'||,
    TIME(v.e)
   Parse Var vx vt '**' vx '**' vy
   Parse Var vt vth ':' vtm ':' vts
   Parse Var vx vxl '*' vxh '*' vxm '*' vxs '*' vxe '*' vxr '*' vxc
   Parse Var vy vyl '*' vyh '*' vym '*' vys '*' vye '*' vyr '*' vyc

   self~assertSame(tx, ty)
   self~assertSame(txm, ttm+60*tth)
   self~assertSame(txs, tts+60*(ttm+60*tth))
   If tth<10 Then self~assertSame(txh, right(tth, 1))
   else self~assertSame(txh, tth)

   self~assertSame(vx, vy)
   self~assertSame(vxm, vtm+60*vth)
   self~assertSame(vxs, vts+60*(vtm+60*vth))
   If vth<10 Then self~assertSame(vxh, right(vth, 1))
   else self~assertSame(vxh, vth)

   self~assertSame(txe, txr)
   self~assertTrue(txe<='1')

   self~assertSame(vxe, vxr)

   self~assertSame(txl, tyl)
   self~assertSame(vxl, vyl)

   Parse Var txl txlh ':' txlm ':' txls '.' txlms
   Parse Var vxl vxlh ':' vxlm ':' vxls '.' vxlms
   tmsc=SUBSTR(txl,9,7)
   vmsc=SUBSTR(vxl,9,7)
   Numeric Digits 20
   txlc=txls+60*(txlm+60*txlh)+tmsc
   vxlc=vxls+60*(vxlm+60*vxlh)+vmsc
   xlc=vxlc-txlc

   self~assertSame(vxr, xlc)


